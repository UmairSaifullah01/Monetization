%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cf7bc3c2b4a664206b1acdbb294949e8, type: 3}
  m_Name: MonetizationKeysSO
  m_EditorClassIdentifier: 
  jsonFilePath: Assets/Monetization/Resources/MonetizationKeys.json
  keysData:
    categories:
    - categoryName: AdKeys
      keys:
      - keyName: BannerTop
        keyValue: ca-app-pub-1234567890/banner_top
      - keyName: BannerBottom
        keyValue: ca-app-pub-1234567890/banner_bottom
      - keyName: Rewarded
        keyValue: ca-app-pub-1234567890/rewarded_video
      - keyName: Interstitial
        keyValue: ca-app-pub-1234567890/interstitial
      - keyName: AppOpen
        keyValue: ca-app-pub-1234567890/app_open
    - categoryName: IAPKeys
      keys:
      - keyName: NoAds
        keyValue: remove_ads
      - keyName: GemPackSmall
        keyValue: gems_small_pack
      - keyName: GemPackMedium
        keyValue: gems_medium_pack
      - keyName: GemPackLarge
        keyValue: gems_large_pack
      - keyName: CoinPackSmall
        keyValue: coins_small_pack
      - keyName: CoinPackLarge
        keyValue: coins_large_pack
      - keyName: PremiumSubscription
        keyValue: premium_subscription_monthly
      - keyName: ProSubscription
        keyValue: pro_subscription_yearly
    - categoryName: AnalyticsKeys
      keys:
      - keyName: FirebaseProjectId
        keyValue: your-firebase-project-id
      - keyName: GameAnalyticsGameKey
        keyValue: your-ga-game-key
      - keyName: GameAnalyticsSecretKey
        keyValue: your-ga-secret-key
    - categoryName: RemoteConfigKeys
      keys:
      - keyName: RemoteConfigUrl
        keyValue: https://your-remote-config-url.com/config
      - keyName: ApiKey
        keyValue: your-api-key
      - keyName: Environment
        keyValue: production
