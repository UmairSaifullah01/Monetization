{
  "corePackages": {
    "com.thebaddest.utask": "https://github.com/UmairSaifullah01/UTask.git"
  },
  "registries": [
    {
      "name": "OpenUPM",
      "url": "https://package.openupm.com",
      "scopes": [
        "com.google",
        "com.gameanalytics"
      ]
    }
  ],
  "providers": {
    "ads_google": {
      "label": "Google AdMob",
      "packages": {
        "com.google.ads.mobile": "10.3.0"
      },
      "tgzPackages": {},
      "asmdef": "THEBADDEST.Monetization.Ads.Google",
      "moduleType": "THEBADDEST.Advertisement.GoogleAdsModule"
    },
    "analytics_gameanalytics": {
      "label": "GameAnalytics",
      "packages": {
        "com.gameanalytics.sdk": "7.10.4"
      },
      "tgzPackages": {},
      "asmdef": "THEBADDEST.Monetization.Analytics.GameAnalytics",
      "moduleType": "THEBADDEST.Analytics.GAAnalyticsModule"
    },
    "iap_unity": {
      "label": "Unity IAP",
      "packages": {
        "com.unity.purchasing": "4.10.0"
      },
      "tgzPackages": {},
      "asmdef": "THEBADDEST.Monetization.IAP.Unity",
      "moduleType": "THEBADDEST.MonetizationApi.UnityIAPModule"
    },
    "remoteconfig_firebase": {
      "label": "Firebase Remote Config",
      "packages": {},
      "tgzPackages": {
        "com.google.external-dependency-manager-1.2.183.tgz": "com.google.external-dependency-manager",
        "com.google.firebase.app-12.5.0.tgz": "com.google.firebase.app",
        "com.google.firebase.remote-config-12.5.0.tgz": "com.google.firebase.remote-config"
      },
      "asmdef": "THEBADDEST.Monetization.RemoteConfig.Firebase",
      "moduleType": "THEBADDEST.RemoteConfigSystem.FirebaseRemoteConfig"
    }
  }
}
